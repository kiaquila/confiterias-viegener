{
  "name": "confiterias-viegener",
  "private": true,
  "description": "Confiterías Viegener — repository baseline, checks and the website in website/",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-repository.mjs && node scripts/check-managed-files.mjs",
    "test": "node scripts/test-web-design.mjs && node --test \"tests/repository-guard.test.mjs\"",
    "preflight": "npm run check && npm test",
    "setup": "node scripts/bootstrap-project.mjs",
    "project:check": "node scripts/run-project-checks.mjs",
    "sync:web-design": "node scripts/sync-project.mjs",
    "manifest:web-design": "node scripts/build-release-manifest.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
